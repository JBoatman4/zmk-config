#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Pro Micro F4 -> Label 029 (D21)
            , <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Pro Micro F5 -> Label 031 (D20)
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Pro Micro F6 -> Label 115 (D19)
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Pro Micro F7 -> Label 113 (D18)
            ;

        col-gpios
            = <&gpio0 6  GPIO_ACTIVE_HIGH> // Pro Micro B1 -> Label 006 (D1)
            , <&gpio0 8  GPIO_ACTIVE_HIGH> // Pro Micro B3 -> Label 008 (D0)
            , <&gpio0 17 GPIO_ACTIVE_HIGH> // Pro Micro B2 -> Label 017 (D2)
            , <&gpio1 9  GPIO_ACTIVE_HIGH> // Pro Micro B6 -> Label 109 (D10)
            , <&gpio0 2  GPIO_ACTIVE_HIGH> // Pro Micro E6 -> Label 002 (D15)
            ;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // Pro Micro D4 -> Label 022 (D4)
        b-gpios = <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // Pro Micro B2 -> Label 017 (D2)
        steps = <80>;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };
};
