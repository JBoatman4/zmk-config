#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // PCB F4 -> nice!nano 031
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // PCB F5 -> nice!nano 029
            , <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // PCB F6 -> nice!nano 002
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // PCB F7 -> nice!nano 115
            ;

        col-gpios
            = <&gpio1 13 GPIO_ACTIVE_HIGH> // PCB B1 -> nice!nano 113
            , <&gpio1 11 GPIO_ACTIVE_HIGH> // PCB B3 -> nice!nano 111
            , <&gpio0 10 GPIO_ACTIVE_HIGH> // PCB B2 -> nice!nano 010
            , <&gpio0 9  GPIO_ACTIVE_HIGH> // PCB B6 -> nice!nano 009
            , <&gpio0 11 GPIO_ACTIVE_HIGH> // PCB E6 -> nice!nano 011
            ;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // PCB D4 -> nice!nano 022
        b-gpios = <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // PCB C6 -> nice!nano 024 (FIXED)
        steps = <80>;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Dumbpad Layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys = <
            &layout_grid_transform 0 0  &layout_grid_transform 0 1  &layout_grid_transform 0 2  &layout_grid_transform 0 3
            &layout_grid_transform 1 0  &layout_grid_transform 1 1  &layout_grid_transform 1 2  &layout_grid_transform 1 3
            &layout_grid_transform 2 0  &layout_grid_transform 2 1  &layout_grid_transform 2 2  &layout_grid_transform 2 3
            &layout_grid_transform 3 0  &layout_grid_transform 3 1  &layout_grid_transform 3 2  &layout_grid_transform 3 3  &layout_grid_transform 3 4
        >;
    };
};
